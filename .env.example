# ============================================================================
# Mobile Store — Environment template
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real secrets.
# ============================================================================

# ----- Auth.js v5 ------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-32-byte-base64-secret

# Public URL of the app (used by Auth.js for callbacks).
# Local dev: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000

# Trust the host header — required when running behind a reverse proxy.
AUTH_TRUST_HOST=true

# ----- Storefront base URL (SEO / sitemap / canonical links) ----------------
# Set to the public URL of the storefront in production. Falls back to
# AUTH_URL / VERCEL deployment URL when unset.
# STOREFRONT_BASE_URL=https://your-domain.com

# ----- MongoDB ---------------------------------------------------------------
# MongoDB connection string. The database name MUST be in the path.
# Example: mongodb+srv://user:pass@cluster.mongodb.net/mobile-store?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mobile-store?retryWrites=true&w=majority

# ----- Upload storage --------------------------------------------------------
# Product images, offer banners, grade videos, SEO images, and chat attachments
# are stored through Vercel Blob by default.
STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional reference only; the app does not read this at runtime.
# BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx

# ----- OTP delivery (customer phone sign-in) --------------------------------
# Cheapest production setup: WhatsApp only via Twilio (no SMS fallback).
# Dev: leave Twilio unset → codes print in the server log.
#
# Full setup guide: docs/otp-setup.md
#
# OTP_PROVIDER=twilio

# Twilio — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp sender (required for production).
# Sandbox while testing: whatsapp:+14155238886
# Live: your approved WhatsApp Business sender, e.g. whatsapp:+923204862403
TWILIO_WHATSAPP_FROM=

# SMS — used ONLY when the recipient is not on WhatsApp (Twilio error 63024).
# Set this if you want non-WhatsApp numbers to receive OTPs via SMS.
TWILIO_SMS_FROM=

# Rarely needed:
# OTP_DISABLE_WHATSAPP=1   → SMS-only mode
# OTP_DISABLE_SMS=1        → never SMS, even when number is not on WhatsApp
